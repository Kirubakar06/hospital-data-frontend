{
  "name": "carepoint-hospital-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix \"..\\backend and database\" run dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm --prefix \"..\\backend and database\" start",
    "test:backend": "npm --prefix \"..\\backend and database\" test",
    "db:setup": "npm --prefix \"..\\backend and database\" run db:setup",
    "seed:admin": "npm --prefix \"..\\backend and database\" run seed:admin",
    "seed:demo": "npm --prefix \"..\\backend and database\" run seed:demo"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}
